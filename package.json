{
  "name": "aetherlink-theia-engine",
  "version": "0.1.0",
  "description": "AetherLinkOS — AI-native cloud operating platform with live voice terminal",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "start": "node dist/theia/backend/main.js",
    "terminal": "ts-node src/terminal/server/index.ts",
    "brain": "npm start --prefix oracle-live-brain",
    "brain:dev": "npm run dev --prefix oracle-live-brain",
    "brain:test": "node oracle-live-brain/scripts/connection-test.mjs",
    "test": "jest",
    "test:unit": "jest --testPathPattern=\\.test\\.ts$",
    "lint": "eslint 'src/**/*.ts' --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "node-pty": "^1.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
