# Shared secret required for turn ingest. The page and the live socket stay open without it.
ORACLE_INGEST_TOKEN=replace-with-a-long-random-string

# HTTP port. The process binds 0.0.0.0 so a host can route traffic to it.
PORT=4317

# Persistent brain file. On a host with a disk, point this at the mount.
ORACLE_DATA_PATH=./data/state.json

# Optional. Talk-to-the-brain uses this key, then ANTHROPIC_API_KEY.
# With neither key and no ORACLE_LLM_URL, replies use the built-in template.
ORACLE_LLM_API_KEY=
ANTHROPIC_API_KEY=
ORACLE_LLM_MODEL=claude-3-5-haiku-20241022

# Optional custom model endpoint. POST { question, system, state }
# and return { sentences: [{ text, faculty }] }.
ORACLE_LLM_URL=

# Used by the agent clients, not by the server.
ORACLE_BRAIN_URL=http://127.0.0.1:4317
ORACLE_AGENT_NAME=grok-bot
